{
  "name": "clone-tabnews",
  "version": "1.0.0",
  "description": "Implementação do https://www.tabnews.com.br para o https://curso.dev",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "docker-compose -f infra/compose.yaml up -d",
    "services:stop": "docker-compose -f infra/compose.yaml stop",
    "services:down": "docker-compose -f infra/compose.yaml down",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watchAll"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaiFish/clone-tabnews.git"
  },
  "author": "Anderson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HaiFish/clone-tabnews/issues"
  },
  "homepage": "https://github.com/HaiFish/clone-tabnews#readme",
  "dependencies": {
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "sharp@0.34.4": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "prettier": "^3.9.6"
  }
}
